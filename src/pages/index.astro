---
import Layout from "../layouts/Layout.astro";

import Badge from "../components/Bagde.astro";

import LinkedInIcon from "../components/icons/LinkedIn.astro";
import GitHubIcon from "../components/icons/GitHub.astro";
import BehanceIcon from "../components/icons/Behance.astro";
import EmailIcon from "../components/icons/Email.astro";

import SocialPill from "../components/SocialPill.astro";
import Experience from "../components/Experience.astro";
import SectionContainer from "../components/SectionContainer.astro";

import Briefcase from "../components/icons/Briefcase.astro";
import CodeIcon from "../components/icons/Code.astro";

import Projects from "../components/Projects.astro";
import TechStack from "../components/TechStack.astro";
---

<Layout title="Nestor Rivas — Frontend Developer & Software Engineer">
  <main class="px-4">
    <!-- =========================
         HERO
    ========================== -->
    <SectionContainer class="py-38 pb-12">
      <div class="max-w-5xl">
        <!-- Availability -->
        <div class="mb-5">
          <a
            href="https://www.linkedin.com/in/nestor-rivas-5a6163196/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex"
          >
            <Badge>Available for hire</Badge>
          </a>
        </div>

        <!-- Name -->
        <h1
          class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight pb-6"
        >
          hey, I'm nestor.
        </h1>

        <!-- Main headline -->
        <h2
          class="text-xl md:text-2xl lg:text-3xl leading-relaxed max-w-4xl text-gray-800 dark:text-gray-200"
        >
          Frontend Developer focused on building
          <span class="text-sky-800 dark:text-sky-400">
            scalable, responsive and user-centered web applications.
          </span>
        </h2>

        <!-- Supporting description -->
        <p
          class="mt-5 text-base md:text-lg leading-relaxed max-w-3xl text-gray-600 dark:text-gray-400"
        >
          Experienced with React, TypeScript and modern frontend
          technologies, with additional experience in backend development,
          APIs, databases and enterprise software systems.
        </p>

        <p
          class="mt-2 text-base md:text-lg text-sky-900 dark:text-sky-400 opacity-80"
        >
          Based in El Salvador · Available for remote opportunities.
        </p>

        <!-- Social links -->
        <nav
          class="flex gap-3 md:gap-4 mt-8 flex-wrap"
          aria-label="Social links"
        >
          <SocialPill
            href="https://www.linkedin.com/in/nestor-rivas-5a6163196/"
          >
            <LinkedInIcon class="size-4 md:size-5" />
            LinkedIn
          </SocialPill>

          <SocialPill href="https://github.com/rotsenk">
            <GitHubIcon class="size-4 md:size-5" />
            GitHub
          </SocialPill>

          <SocialPill href="https://www.behance.net/stanleyrivas">
            <BehanceIcon class="size-4 md:size-5" />
            Behance
          </SocialPill>

          <SocialPill href="mailto:stanley.95@hotmail.com">
            <EmailIcon class="size-4 md:size-5" />
            stanley.95@hotmail.com
          </SocialPill>
        </nav>
      </div>
    </SectionContainer>

    <!-- =========================
         TECH STACK
    ========================== -->
    <SectionContainer id="tech-stack">
      <TechStack />
    </SectionContainer>

    <!-- =========================
         EXPERIENCE
    ========================== -->
    <SectionContainer id="experience">
      <h2
        class="text-3xl font-semibold mb-8 flex gap-x-2 items-center"
      >
        <Briefcase class="size-8" />
        Work Experience
      </h2>

      <Experience />
    </SectionContainer>

    <!-- =========================
         PROJECTS
    ========================== -->
    <SectionContainer id="projects">
      <h2
        class="text-3xl font-semibold mb-4 flex gap-x-2 items-center"
      >
        <CodeIcon class="size-8" />
        Personal & Academic Projects
      </h2>

      <Projects />
    </SectionContainer>
  </main>
</Layout>