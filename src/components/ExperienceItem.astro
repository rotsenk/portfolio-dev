---
export interface Props {
  title: string;
  description: string;
  link?: string;
  date: string;
}

const { title, description, link, date } = Astro.props;
---

<li class="relative mb-10 ms-6 last:mb-0">

  <!-- Timeline dot -->
  <div
    class="absolute -start-[1.15rem] mt-1.5
           h-3 w-3 rounded-full
           border-2 border-white
           bg-sky-500
           dark:border-gray-900
           dark:bg-sky-400"
  ></div>

  <!-- Date -->
  <time
    class="mb-2 block text-sm font-medium
           text-sky-700 dark:text-sky-400"
  >
    {date}
  </time>

  <!-- Title -->
  <h3
    class="text-lg font-semibold
           text-gray-900 dark:text-white"
  >
    {title}
  </h3>

  <!-- Description -->
  <p
    class="mt-2 mb-4 text-base leading-relaxed
           text-gray-600 dark:text-gray-400
           text-pretty"
  >
    {description}
  </p>

  <!-- Optional link -->
  {
    link && (
      <a
        href={link}
        class="inline-flex items-center gap-2
               rounded-lg border
               border-gray-200
               bg-white px-4 py-2
               text-sm font-medium
               text-gray-900
               transition-colors
               hover:bg-gray-100
               hover:text-sky-700
               focus:outline-none
               focus:ring-4
               focus:ring-gray-100
               dark:border-gray-700
               dark:bg-gray-800
               dark:text-gray-300
               dark:hover:bg-gray-700
               dark:hover:text-white
               dark:focus:ring-gray-700"
      >
        Learn more

        <svg
          class="h-3 w-3"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 14 10"
        >
          <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M1 5h12m0 0L9 1m4 4L9 9"
          />
        </svg>
      </a>
    )
  }

</li>