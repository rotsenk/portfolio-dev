---
const techStack = [
  {
    category: "Frontend",
    description: "Modern and scalable web interfaces",
    technologies: [
      {
        name: "React",
        icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/react/react-original.svg",
        featured: true,
      },
      {
        name: "TypeScript",
        icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/typescript/typescript-original.svg",
        featured: true,
      },
      {
        name: "JavaScript",
        icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/javascript/javascript-original.svg",
      },
      {
        name: "Redux Toolkit",
        icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/redux/redux-original.svg",
      },
      {
        name: "React Router",
        icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/reactrouter/reactrouter-original.svg",
      },
      {
        name: "Tailwind CSS",
        icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/tailwindcss/tailwindcss-original.svg",
      },
      {
        name: "HTML5",
        icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/html5/html5-original.svg",
      },
      {
        name: "CSS3",
        icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/css3/css3-original.svg",
      },
      {
        name: "Bootstrap",
        icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/bootstrap/bootstrap-original.svg",
      },
    ],
  },

  {
    category: "Backend",
    description: "APIs, business logic and server-side development",
    technologies: [
      {
        name: "Node.js",
        icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/nodejs/nodejs-original.svg",
      },
      {
        name: "Express",
        icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/express/express-original.svg",
      },
      {
        name: ".NET",
        icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/dotnetcore/dotnetcore-original.svg",
      },
      {
        name: "C#",
        icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/csharp/csharp-original.svg",
      },
    ],
  },

  {
    category: "Database",
    description: "Relational and NoSQL data management",
    technologies: [
      {
        name: "SQL Server",
        icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/microsoftsqlserver/microsoftsqlserver-plain.svg",
      },
      {
        name: "MongoDB",
        icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/mongodb/mongodb-original.svg",
      },
    ],
  },

  {
    category: "Design & UI/UX",
    description: "Interfaces, visual design and user experience",
    technologies: [
      {
        name: "Figma",
        icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/figma/figma-original.svg",
      },
    ],
  },

  {
  category: "Database",
  description: "Relational and NoSQL data management",
  technologies: [
    {
      name: "SQL Server",
      icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/microsoftsqlserver/microsoftsqlserver-plain.svg",
    },
    {
      name: "PostgreSQL",
      icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/postgresql/postgresql-original.svg",
    },
    {
      name: "MongoDB",
      icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/mongodb/mongodb-original.svg",
    },
  ],
},
];
---

<section id="tech-stack">
  <div class="mx-auto max-w-6xl px-4">

    <!-- Section Header -->
    <div class="mb-10 max-w-2xl">
      <span
        class="text-sm font-medium uppercase tracking-wider
               text-gray-500 dark:text-gray-400"
      >
        My toolkit
      </span>

      <h2
        class="mt-2 text-3xl font-bold tracking-tight
               text-gray-900 dark:text-white
               md:text-4xl"
      >
        Technologies I work with
      </h2>

      <p
        class="mt-4 text-base leading-relaxed
               text-gray-600 dark:text-gray-400"
      >
        A frontend-focused technology stack backed by experience in
        backend development, databases, and UI/UX design.
      </p>
    </div>


    <!-- Technology Categories -->
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">

      {
        techStack.map((stack) => (
          <article
            class="rounded-2xl border
                   border-gray-200 bg-white p-6
                   shadow-sm
                   transition-all duration-300
                   hover:-translate-y-1 hover:shadow-md
                   dark:border-gray-800 dark:bg-gray-900"
          >

            <!-- Category Header -->
            <div class="mb-6">
              <h3
                class="text-xl font-semibold
                       text-gray-900 dark:text-white"
              >
                {stack.category}
              </h3>

              <p
                class="mt-1 text-sm
                       text-gray-500 dark:text-gray-400"
              >
                {stack.description}
              </p>
            </div>


            <!-- Technologies -->
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">

              {
                stack.technologies.map((technology) => (
                  <div
                    class="group flex items-center gap-3
                           rounded-xl border
                           border-transparent
                           p-3
                           transition-all duration-200
                           hover:border-gray-200
                           hover:bg-gray-50
                           dark:hover:border-gray-700
                           dark:hover:bg-gray-800/60"
                  >

                    <!-- Technology Icon -->
                    <div
                      class="flex h-9 w-9 shrink-0
                             items-center justify-center"
                    >
                      <img
                        src={technology.icon}
                        alt={`${technology.name} logo`}
                        loading="lazy"
                        class="h-8 w-8 object-contain
                               transition-transform duration-200
                               group-hover:scale-110"
                      />
                    </div>

                    <!-- Technology Name -->
                    <span
                      class="text-sm font-medium
                             text-gray-700
                             transition-colors
                             group-hover:text-gray-950
                             dark:text-gray-300
                             dark:group-hover:text-white"
                    >
                      {technology.name}
                    </span>

                  </div>
                ))
              }

            </div>
          </article>
        ))
      }

    </div>


    <!-- Primary Focus -->
    <div
      class="mt-8 rounded-2xl border
             border-gray-200 bg-gray-50 p-6
             dark:border-gray-800 dark:bg-gray-900/50
             md:p-8"
    >

      <div
        class="flex flex-col gap-6
               md:flex-row md:items-center
               md:justify-between"
      >

        <!-- Focus Description -->
        <div class="max-w-2xl">

          <span
            class="text-sm font-medium uppercase tracking-wider
                   text-gray-500 dark:text-gray-400"
          >
            Primary focus
          </span>

          <h3
            class="mt-2 text-2xl font-bold
                   text-gray-900 dark:text-white"
          >
            Frontend Engineering
          </h3>

          <p
            class="mt-3 text-sm leading-relaxed
                   text-gray-600 dark:text-gray-400"
          >
            I specialize in building modern web applications with
            React and TypeScript, while leveraging backend technologies
            and databases to deliver complete and scalable solutions.
          </p>

        </div>


        <!-- Core Technologies -->
        <div class="flex flex-wrap gap-2 md:max-w-sm md:justify-end">

          <span
            class="rounded-full
                   bg-gray-900 px-3 py-1.5
                   text-sm font-medium text-white
                   dark:bg-white dark:text-gray-900"
          >
            React
          </span>

          <span
            class="rounded-full
                   bg-gray-200 px-3 py-1.5
                   text-sm font-medium text-gray-800
                   dark:bg-gray-800 dark:text-gray-200"
          >
            TypeScript
          </span>

          <span
            class="rounded-full
                   bg-gray-200 px-3 py-1.5
                   text-sm font-medium text-gray-800
                   dark:bg-gray-800 dark:text-gray-200"
          >
            Redux Toolkit
          </span>

          <span
            class="rounded-full
                   bg-gray-200 px-3 py-1.5
                   text-sm font-medium text-gray-800
                   dark:bg-gray-800 dark:text-gray-200"
          >
            Tailwind CSS
          </span>

        </div>

      </div>

    </div>

  </div>
</section>