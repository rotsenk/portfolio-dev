---
import LinksPill from "../components/LinksPill.astro";
import GitHubIcon from "../components/icons/GitHub.astro";
import BrowserIcon from "../components/icons/Browser.astro";

import Tailwind from "./icons/Tailwind.astro";
import HTMLIcon from "./icons/HTMLIcon.astro";
import CSSIcon from "./icons/CSS.astro";
import ReactIcon from "./icons/React.astro";
import ReduxIcon from "./icons/Redux.astro";
import JSIcon from "./icons/JavaScript.astro";
import BootstrapIcon from "./icons/Bootstrap.astro";
import FigmaIcon from "./icons/Figma.astro";
import AdIlluIcon from "./icons/AdIllu.astro";
import AdPhIcon from "./icons/AdPh.astro";
import TypeScript from "./icons/TypeScript.astro";

const styles_class =
  "bg-black/5 hover:scale-110 hover:bg-black/10 transition border border-black/10";

const TAGS = {
  TS: {
    name: "TypeScript",
    class: styles_class,
    icon: TypeScript,
  },

  TAILWIND: {
    name: "Tailwind CSS",
    class: styles_class,
    icon: Tailwind,
  },

  HTML: {
    name: "HTML5",
    class: styles_class,
    icon: HTMLIcon,
  },

  CSS: {
    name: "CSS3",
    class: styles_class,
    icon: CSSIcon,
  },

  REACT: {
    name: "React",
    class: styles_class,
    icon: ReactIcon,
  },

  REDUX: {
    name: "Redux",
    class: styles_class,
    icon: ReduxIcon,
  },

  JAVASCRIPT: {
    name: "JavaScript",
    class: styles_class,
    icon: JSIcon,
  },

  BOOTSTRAP: {
    name: "Bootstrap",
    class: styles_class,
    icon: BootstrapIcon,
  },

  FIGMA: {
    name: "Figma",
    class: styles_class,
    icon: FigmaIcon,
  },

  ILLUSTRATOR: {
    name: "Illustrator",
    class: styles_class,
    icon: AdIlluIcon,
  },

  PHOTOSHOP: {
    name: "Photoshop",
    class: styles_class,
    icon: AdPhIcon,
  },
};

const PROJECTS = [
  {
    title: "TaenlyPods Landing Page",

    description:
      "A premium product landing page built with React, TypeScript, and Tailwind CSS. The project focuses on visual hierarchy, conversion-oriented design, responsive layouts, strategic calls to action, interactive sections, and subtle animations to create a polished user experience.",

    link: "https://taenlypods-landing.netlify.app/",

    github: "https://github.com/rotsenk/taenlypods-landing",

    image: "/images/staenlypods-landing.png",

    tags: [TAGS.REACT, TAGS.TAILWIND, TAGS.TS],
  },

  {
    title: "Sales Dashboard App",

    description:
      "A responsive sales dashboard built with React, TypeScript, and Tailwind CSS to present business data through reusable interface components. The project emphasizes information hierarchy, responsive design, usability, micro-interactions, and maintainable frontend architecture.",

    link: "https://sales-dashboard-application.netlify.app/",

    github: "https://github.com/rotsenk/sales-dashboard-application",

    image: "/images/sales-dashboard.png",

    tags: [TAGS.REACT, TAGS.TAILWIND, TAGS.TS],
  },

  {
    title: "Business Cards App",

    description:
      "A digital business card directory developed with React, TypeScript, and Tailwind CSS. The interface includes responsive layouts, reusable components, interactive 3D card effects, progressive disclosure, and visual feedback designed to provide a modern and intuitive experience across devices.",

    link: "https://business-cards-application.netlify.app/",

    github: "https://github.com/rotsenk/business-cards-application",

    image: "/images/business-cards-app.png",

    tags: [TAGS.REACT, TAGS.TAILWIND, TAGS.TS],
  },

  {
    title: "GenerousApp — Mobile UX/UI",

    description:
      "A mobile application concept designed to facilitate donations to children's homes. The project focuses on transparency, personalization, and user engagement through donation reports, impact stories, and a rewards system for frequent donors. The interface was designed with UX principles and prototyped in Figma.",

    link: "https://www.figma.com/proto/LHS3khiEhP5zN2KbEJYEFM/generousApp?node-id=3-2&starting-point-node-id=3%3A2",

    github: "#",

    image: "/images/mobile-generousapp.png",

    tags: [TAGS.FIGMA, TAGS.ILLUSTRATOR, TAGS.PHOTOSHOP],
  },

  {
    title: "Agenda Electrónica",

    description:
      "A Single Page Application for managing personal events and appointments. The project explores React-based application architecture and Redux for centralized state management, with a responsive interface designed for an intuitive scheduling experience.",

    link: "https://agenda-p-redux.netlify.app/",

    github:
      "https://github.com/rotsenk/Agenda-Redux/tree/main/agenda-redux",

    image: "/images/agenda-redux.webp",

    tags: [
      TAGS.HTML,
      TAGS.CSS,
      TAGS.REACT,
      TAGS.REDUX,
      TAGS.BOOTSTRAP,
    ],
  },

  {
    title: "Shopping Cart",

    description:
      "A responsive e-commerce shopping cart application developed with React. The project demonstrates component-based architecture, global state management with Context API, and state updates with useReducer while maintaining a clean and responsive user interface.",

    link: "https://shopping-cartspa.netlify.app/",

    github:
      "https://github.com/rotsenk/SPA-Carrito-Compra/tree/main/shopping-cart",

    image: "/images/shopping-cart.webp",

    tags: [
      TAGS.HTML,
      TAGS.CSS,
      TAGS.REACT,
      TAGS.BOOTSTRAP,
    ],
  },

  {
    title: "eCommerce Platform — UX/UI Design",

    description:
      "An academic UX/UI design project focused on improving the online shopping experience. The project included UX research, information architecture, wireframes, visual design, graphic identity, and a reusable component library to maintain consistency across the interface.",

    link:
      "https://www.figma.com/proto/psIOE9sVKrXCxjUnfpHNtM/It's-Design!-Wireframes?embed_host=share&kind=proto&node-id=294-1318&starting-point-node-id=244%3A1038&t=MRLcynHk410H3FU4-1",

    github: "#",

    image: "/images/guanabox-web.webp",

    tags: [
      TAGS.FIGMA,
      TAGS.ILLUSTRATOR,
      TAGS.PHOTOSHOP,
    ],
  },

  {
    title: "Faculty of Engineering & Architecture — Website",

    description:
      "A university website developed to present academic programs, student procedures, projects, and information related to the Faculty of Engineering and Architecture. I contributed to the visual design and frontend development using HTML, CSS, and JavaScript.",

    link: "https://fia.univo.edu.sv/index.html",

    github: "#",

    image: "/images/fia-web.webp",

    tags: [
      TAGS.HTML,
      TAGS.CSS,
      TAGS.JAVASCRIPT,
    ],
  },

  {
    title: "UniTech 2023 — Event Website",

    description:
      "A responsive event website created for UniTech Week 2023 at Universidad de Oriente. The website presented information about workshops, presentations, schedules, and emerging technology activities throughout the event.",

    link: "https://unitech-univo-2023.netlify.app/",

    github: "https://github.com/rotsenk/UniTech",

    image: "/images/unitech-week-univo.webp",

    tags: [
      TAGS.HTML,
      TAGS.CSS,
      TAGS.BOOTSTRAP,
    ],
  },

  {
    title: "Startup Landing Page",

    description:
      "A customizable landing page template designed for startups and small businesses. It includes sections for services, testimonials, pricing, and calls to action, with a responsive layout focused on usability and conversion.",

    link: "https://landing-page-startups.netlify.app/",

    github: "#",

    image: "/images/LandingStartup.png",

    tags: [
      TAGS.HTML,
      TAGS.CSS,
      TAGS.BOOTSTRAP,
      TAGS.JAVASCRIPT,
    ],
  },
];
---

<section id="projects" class="scroll-mt-24">
  <!-- Section heading -->
  <div class="mb-12">
    <span
      class="text-sm font-semibold uppercase tracking-wider text-sky-600"
    >
      Portfolio
    </span>

    <p
      class="mt-4 max-w-3xl text-base md:text-lg leading-relaxed text-gray-600 dark:text-gray-400"
    >
      A selection of personal and academic projects exploring frontend
      development, UI/UX design, state management, and modern web
      technologies.
    </p>
  </div>

  <!-- Projects -->
  <div>
    {
      PROJECTS.map(
        ({ image, title, description, tags, link, github }, index) => (
          <article
            class:list={[
              "group relative flex flex-col md:flex-row gap-6 mb-12",
              index === PROJECTS.length - 1 ? "last:mb-0" : "",
            ]}
          >
            <!-- Project image -->
            <div class="md:w-2/5 flex-shrink-0">
              <div class="relative overflow-hidden rounded-xl aspect-video md:aspect-square shadow-lg bg-gray-100 dark:bg-gray-800">
                <img
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                  src={image}
                  alt={`Screenshot of ${title}`}
                  loading="lazy"
                  decoding="async"
                />

                <div class="absolute inset-0 bg-gradient-to-br from-sky-500/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
              </div>
            </div>

            <!-- Project content -->
            <div class="md:w-3/5 flex flex-col justify-between">
              <div>
                <h3
                  class="text-2xl md:text-3xl font-bold text-sky-800 dark:text-sky-400 mb-3 group-hover:text-sky-600 dark:group-hover:text-sky-300 transition-colors"
                >
                  {title}
                </h3>

                <p
                  class="text-base md:text-lg text-gray-700 dark:text-gray-300 mb-5 leading-relaxed"
                >
                  {description}
                </p>

                <!-- Technologies -->
                <div class="flex flex-wrap gap-2 mb-6">
                  {
                    tags.map((tag) => (
                      <span
                        class:list={[
                          "inline-flex items-center gap-1.5 rounded-full text-xs py-1.5 px-3",
                          tag.class,
                          "text-gray-700 dark:text-gray-300",
                        ]}
                      >
                        <tag.icon class="size-3.5" />
                        {tag.name}
                      </span>
                    ))
                  }
                </div>
              </div>

              <!-- Project links -->
              <div class="flex flex-wrap gap-3 mt-auto">
                {
                  github !== "#" && (
                    <LinksPill href={github}>
                      <GitHubIcon class="size-4" />
                      Code
                    </LinksPill>
                  )
                }

                <LinksPill href={link}>
                  <BrowserIcon class="size-4" />
                  Live Demo
                </LinksPill>
              </div>
            </div>

            <!-- Separator -->
            {
              index !== PROJECTS.length - 1 && (
                <div class="absolute -bottom-6 left-0 right-0 h-px bg-gradient-to-r from-transparent via-sky-200 dark:via-sky-900 to-transparent" />
              )
            }
          </article>
        )
      )
    }
  </div>
</section>