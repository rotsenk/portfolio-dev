---
import ExperienceItem from "./ExperienceItem.astro";

const EXPERIENCE = [
  {
    date: "March 2025 - August 2026",
    title: "Frontend / Web Developer - Grupo Flores",
    description:
      "Developed and maintained enterprise web applications using React, TypeScript, Redux, and .NET technologies. Built reusable UI components, managed application state and data flows, integrated REST APIs, and worked with SQL Server databases. Contributed to scalable solutions, performance improvements, and the modernization of internal business systems.",
  },
  {
    date: "January 2022 - December 2024",
    title: "IT Academic Programs Coordinator - UNIVO",
    description:
      "Coordinated technological academic programs, supervising professors, instructors, and academic workloads. Designed and updated study plans for technology programs and taught specialized subjects in web design and development. Led software development projects and supported the organization of technology labs and learning environments.",
  },
  {
    date: "February - April 2024",
    title: "Frontend Development Consultant - FUSALMO",
    description:
      "Delivered a blended training program focused on frontend development with React. Taught modern web development practices, user interface design, and UX principles, guiding participants through the development of functional and user-centered web applications.",
  },
];
---

<ol class="relative border-s border-gray-200 dark:border-gray-700">
  {
    EXPERIENCE.map((exp) => (
      <li class="mb-10 ms-4">
        <ExperienceItem {...exp} />
      </li>
    ))
  }
</ol>
